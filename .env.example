# Copy this file to ".env" (same folder) and fill in. ".env" is git-ignored.
# Leave BOTH Supabase lines empty to run on the built-in local "cloud" simulator.

AGRITRIAL_API_URL=http://127.0.0.1:8000

# Supabase -> Project Settings -> API
# SUPABASE_URL looks like https://<project-ref>.supabase.co  (nothing after .co, no /rest/v1)
SUPABASE_URL=
# The server-side key (service_role / secret). It stays on the API side only. Never commit it.
SUPABASE_SERVICE_KEY=
