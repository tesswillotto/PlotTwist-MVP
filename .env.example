# Copy this file to ".env" (same folder) and fill in. ".env" is git-ignored.
# Leave the two Supabase lines empty to run on the built-in local "cloud" simulator.

AGRITRIAL_API_URL=http://127.0.0.1:8000

# Supabase -> Project Settings -> API
SUPABASE_URL=
# service_role key (secret). Used by the FastAPI server only, never by the app.
SUPABASE_SERVICE_KEY=
